{
  "name": "local-toptrumps",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc && vite build",
    "build:gh": "tsc && vite build --base /Toptrumps/",
    "build:docs": "tsc && vite build --base /Toptrumps/ --outDir docs",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "preview:gh": "vite preview --base /Toptrumps/ --host 0.0.0.0 --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fetch:cards": "node scripts/fetch-card-art.mjs",
    "ci": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run test:e2e && npm run build && npm run build:gh"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.49.0",
    "eslint": "^10.5.0",
    "globals": "^17.6.0",
    "happy-dom": "^15.11.7",
    "prettier": "^3.8.4",
    "typescript": "~5.4.5",
    "typescript-eslint": "^8.61.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.6"
  }
}
